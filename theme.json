	"styles": {
		"blocks": {
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--courier-prime)",
					"lineHeight": "1.4"
				}
			}
		},
		"color": {
			"background": "#ffffff",
			"text": "#000000"
		},
		"elements": {
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cabin)"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--black)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cactus-classical-serif)"
				}
			},
			"heading": {
				"color": {
					"text": "#912121"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--berkshire-swash)"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--vivid-purple)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--vivid-cyan-blue)"
				}
			}
		},
		"spacing": {
			"blockGap": "34px"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--cabin)",
			"fontSize": "16px",
			"lineHeight": "1.8"
		}
	},
	"version": 3
}