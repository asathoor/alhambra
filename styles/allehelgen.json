{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"settings": {
		"appearanceTools": true,
		"blocks": {
			"core/post-content": {
				"layout": {
					"contentSize": "800px",
					"wideSize": "1200px"
				}
			}
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": true,
			"defaultGradients": true,
			"defaultPalette": true,
			"duotone": [],
			"gradients": [],
			"palette": []
		},
		"custom": {
			"lineHeight": true,
			"spacing": true
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"dropCap": true,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Cabin",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": "File:./assets/fonts/Cabin/Cabin-VariableFont_wdth_wght.ttf"
						},
						{
							"fontFamily": "Cabin",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": "File:./assets/fonts/Cabin/Cabin-VariableFont_wdth_wght.ttf"
						},
						{
							"fontFamily": "Cabin",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": "File:./assets/fonts/Cabin/Cabin-VariableFont_wdth_wght.ttf"
						},
						{
							"fontFamily": "Cabin",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": "File:./assets/fonts/Cabin/Cabin-VariableFont_wdth_wght.ttf"
						},
						{
							"fontFamily": "Cabin",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": "File:./assets/fonts/Cabin/Cabin-Italic-VariableFont_wdth_wght.ttf"
						},
						{
							"fontFamily": "Cabin",
							"fontStyle": "italic",
							"fontWeight": "500",
							"src": "File:./assets/fonts/Cabin/Cabin-Italic-VariableFont_wdth_wght.ttf"
						},
						{
							"fontFamily": "Cabin",
							"fontStyle": "italic",
							"fontWeight": "600",
							"src": "File:./assets/fonts/Cabin/Cabin-Italic-VariableFont_wdth_wght.ttf"
						},
						{
							"fontFamily": "Cabin",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": "File:./assets/fonts/Cabin/Cabin-Italic-VariableFont_wdth_wght.ttf"
						}
					],
					"fontFamily": "Cabin, sans-serif",
					"name": "Cabin",
					"slug": "cabin"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"Berkshire Swash\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": "File:./assets/fonts/Berkshire_Swash/assets/fonts/Berkshire_Swash/BerkshireSwash-Regular.ttf"
						}
					],
					"fontFamily": "\"Berkshire Swash\", cursive",
					"name": "Berkshire Swash",
					"slug": "berkshire-swash"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"Courier Prime\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": "File:./assets/fonts/Courier_Prime/CourierPrime-Regular.ttf"
						},
						{
							"fontFamily": "\"Courier Prime\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": "File:./assets/fonts/Courier_Prime/CourierPrime-Regular.ttf"
						},
						{
							"fontFamily": "\"Courier Prime\"",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": "File:./assets/fonts/Courier_Prime/CourierPrime-Italic.ttf"
						},
						{
							"fontFamily": "\"Courier Prime\"",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": "File:./assets/fonts/Courier_Prime/CourierPrime-Italic.ttf"
						}
					],
					"fontFamily": "\"Courier Prime\", monospace",
					"name": "Courier Prime",
					"slug": "courier-prime"
				}
			],
			"fontSizes": [],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true
		}
	},
	"styles": {
		"blocks": {
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--courier-prime)",
					"lineHeight": "1.4"
				}
			}
		},
		"color": {
			"background": "#ffffff",
			"text": "#000000"
		},
		"elements": {
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cabin)"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--black)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cactus-classical-serif)"
				}
			},
			"heading": {
				"color": {
					"text": "#912121"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--berkshire-swash)"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--vivid-purple)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--vivid-cyan-blue)"
				}
			}
		},
		"spacing": {
			"blockGap": "15px"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--cabin)",
			"fontSize": "16px",
			"lineHeight": "1.8"
		}
	},
	"version": 3
}