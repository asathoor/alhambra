{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",

	"customTemplates": [
		{
			"name": "front-page",
			"title": "The front page"
		},
		{
			"name": "test-code",
			"postTypes": [
				"page"
			],
			"title": "This is a test page"
		}
	],
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": true,
			"defaultGradients": true,
			"defaultPalette": true,
			"palette": [
				{
					"color": "#d155c6",
					"name": "Flump",
					"slug": "flump"
				},
				{
					"color": "#ff0000",
					"name": "Rosa Red",
					"slug": "rosa-red"
				},
				{
					"color": "#000",
					"name": "Sort",
					"slug": "custom-sort"
				},
				{
					"color": "#ffffff",
					"name": "Hvid",
					"slug": "custom-hvid"
				},
				{
					"color": "#207410",
					"name": "Mørkegrøn",
					"slug": "custom-m-rkegr-n"
				},
				{
					"color": "#403a3a42",
					"name": "Transparent grå",
					"slug": "custom-transparent-gr"
				}
			]
		},
		"layout": {
			"contentSize": "777px",
			"wideSize": "1111px"
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Oxygen-Sans,Ubuntu,Cantarell,\"Helvetica Neue\",sans-serif",
					"name": "System Fonts",
					"slug": "system-fonts"
				},
				{
					"fontFamily": "Geneva, Tahoma, Verdana, sans-serif",
					"name": "Geneva, Tahoma, Verdana, sans-serif",
					"slug": "geneva-verdana"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Arbutus",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": "http://staging-1756812069.thoth.dk/wp-content/uploads/fonts/NaPYcZ7dG_5J3poob9dtryO8fMU.woff2"
						}
					],
					"fontFamily": "Arbutus, serif",
					"name": "Arbutus",
					"slug": "arbutus"
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"size": "1rem",
					"slug": "small"
				},
				{
					"name": "Extra large",
					"size": "3rem",
					"slug": "extra-large"
				},
				{
					"name": "Større",
					"size": "1.2rem",
					"slug": "custom-1"
				},
				{
					"name": "Stor",
					"size": "1.4rem",
					"slug": "custom-2"
				}
			],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"textDecoration": true
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--arbutus)",
					"fontStyle": "normal",
					"fontWeight": "700"
				}
			}
		},
		"spacing": {
			"blockGap": "27px",
			"padding": {
				"bottom": "0px",
				"left": "0px",
				"right": "0px",
				"top": "0px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--geneva-verdana)",
			"fontSize": "var(--wp--preset--font-size--custom-2)"
		}
	},
	"title": "Mandragora",
	"version": 3
}