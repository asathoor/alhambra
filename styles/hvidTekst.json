	"styles": {
		"blocks": {
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--courier-prime)",
					"lineHeight": "1.4"
				}
			},
			"core/table": {
				"color": {
					"background": "var(--wp--preset--color--custom-lillam-rke)",
					"text": "var(--wp--preset--color--custom-vokslys)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--custom-vokslys)"
						}
					}
				},
				"variations": {
					"stripes": {
						"color": {
							"background": "var(--wp--preset--color--custom-m-rkeviolet)",
							"text": "var(--wp--preset--color--custom-gr-n-kontrast)"
						},
						"elements": {
							"link": {
								"color": {
									"text": "var(--wp--preset--color--custom-gr-n-kontrast)"
								}
							}
						}
					}
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--custom-lillam-rke)",
			"text": "var(--wp--preset--color--white)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--custom-m-rkeviolet)",
					"text": "var(--wp--preset--color--custom-gr-n-kontrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cabin)",
					"fontSize": "34px"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--custom-gr-n-kontrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cactus-classical-serif)"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cabin)"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cabin)"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cabin)"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cabin)"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--cabin)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--custom-r-d-kontrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--berkshire-swash)",
					"lineHeight": "1.9"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--custom-r-d-kontrast)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--pale-cyan-blue)"
				}
			}
		},
		"spacing": {
			"blockGap": "15px"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--cabin)",
			"fontSize": "var(--wp--preset--font-size--custom-2)",
			"lineHeight": "1.8"
		}
